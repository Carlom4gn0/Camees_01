  { name: 'Universidad Católica de Santa Fe',        img: '/images/alianzas/ucsf.png',                  url: 'https://www.ucsf.edu.ar' },
  { name: 'Agencia para el Desarrollo de Santa Fe',  img: '/images/alianzas/agencia-desarrollo.png',    url: '#' },
